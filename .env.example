# Copy this file to .env and fill in real values. .env is never committed.

# Postgres, used by the API, the worker, and pg-boss.
DATABASE_URL=postgres://holocron:holocron@localhost:5432/holocron

# Port the API listens on locally. Compose sets this itself for its own services.
PORT=3000

# Where the OCR language file is kept. Inside Docker this is the /data volume.
OCR_CACHE_DIR=.scratch/data/tesseract
